#. HTTP 400 Bad Request
msgid "Bad Request"
msgstr "طلب غير صالح"

msgid "Sorry, your request could not be processed."
msgstr "عذراً، لم نتمكن من معالجة طلبك."

#. HTTP 401 Unauthorized
msgid "Unauthorized"
msgstr "غير مصرح"

msgid "Authentication is required to access this resource."
msgstr "يتطلب الوصول إلى هذا المورد المصادقة."

msgid "Please log in to continue."
msgstr "يرجى تسجيل الدخول للمتابعة."

#. HTTP 403 Forbidden
msgid "Forbidden"
msgstr "محظور"

msgid "You do not have permission to access this resource."
msgstr "ليس لديك إذن للوصول إلى هذا المورد."

#. HTTP 404 Not Found
msgid "Page Not Found"
msgstr "الصفحة غير موجودة"

msgid "Sorry, the page you are looking for does not exist."
msgstr "عذراً، الصفحة التي تبحث عنها غير موجودة."

msgid "Return to the homepage."
msgstr "العودة إلى الصفحة الرئيسية."

#. HTTP 405 Method Not Allowed
msgid "Method Not Allowed"
msgstr "الطريقة غير مسموحة"

msgid "The requested method is not allowed for this resource."
msgstr "الطريقة المطلوبة غير مسموحة لهذا المورد."

#. HTTP 408 Request Timeout
msgid "Request Timeout"
msgstr "انتهت مهلة الطلب"

msgid "The server timed out waiting for your request."
msgstr "انتهت مهلة الخادم في انتظار طلبك."

msgid "Please try again."
msgstr "يرجى المحاولة مرة أخرى."

#. HTTP 410 Gone
msgid "Gone"
msgstr "تم الحذف"

msgid "The requested resource is no longer available."
msgstr "المورد المطلوب لم يعد متاحاً."

#. HTTP 429 Too Many Requests
msgid "Too Many Requests"
msgstr "طلبات كثيرة جداً"

msgid "You have sent too many requests. Please wait before trying again."
msgstr "لقد أرسلت طلبات كثيرة جداً. يرجى الانتظار قبل المحاولة مرة أخرى."

msgid "Please wait and try again later."
msgstr "يرجى الانتظار والمحاولة مرة أخرى لاحقاً."

#. HTTP 500 Internal Server Error
msgid "Internal Server Error"
msgstr "خطأ داخلي في الخادم"

msgid "An unexpected error occurred on the server."
msgstr "حدث خطأ غير متوقع في الخادم."

#. Common messages
msgid "Please return to the homepage."
msgstr "يرجى العودة إلى الصفحة الرئيسية."

msgid "An error occurred"
msgstr "حدث خطأ"

msgid "Something went wrong."
msgstr "حدث خطأ ما."

msgid "Error"
msgstr "خطأ"

msgid "An Error Occurred"
msgstr "حدث خطأ"

#. Template strings
msgid "Go Back"
msgstr "رجوع"

msgid "Return Home"
msgstr "الصفحة الرئيسية"

#. Error details
msgid "No additional details provided."
msgstr "لم يتم تقديم تفاصيل إضافية."
